{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tool-app",
  "version": "0.1.0",
  "identifier": "com.tauri-app.tool-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "划词翻译 · 设置",
        "width": 700,
        "height": 620
      },
      {
        "label": "popup",
        "title": "Translation",
        "url": "popup.html",
        "width": 420,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "trigger-btn",
        "title": "",
        "url": "trigger-btn.html",
        "width": 44,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
